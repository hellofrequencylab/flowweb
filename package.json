{
  "name": "flowweb-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22 <23", "pnpm": ">=10" },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm boundary",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "boundary": "node scripts/boundary-lint.mjs",
    "probe": "node scripts/probe.mjs",
    "schema:test": "python3 -I tests/schema_core_test.py && python3 -I contracts-core/validate.py",
    "fw": "tsx packages/cli/src/bin.ts",
    "fwd": "tsx packages/daemon/src/bin.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
