{
  "id": "stm_paidads1",
  "key": "paid-ads",
  "name": "Paid ads: Find your people locally",
  "project_id": "prj_frequency1",
  "version": 1,
  "template": "custom",
  "enabled": false,
  "trigger": {
    "type": "cron",
    "cron": "0 8 * * 1",
    "timezone": "America/Los_Angeles",
    "catch_up": "skip"
  },
  "inputs": [
    {
      "name": "campaign_report",
      "kind": "query",
      "ref": "flow://paid-ads/imports",
      "untrusted": true
    }
  ],
  "tools": [],
  "action_classes": ["read_research"],
  "output": {
    "artifacts": ["status_report"],
    "result_schema": "run-result.json"
  },
  "verifier": {
    "agent_profile": "marketing-reviewer",
    "vendor_policy": "different_vendor_preferred",
    "read_only": true
  },
  "human_gate": {
    "min_tier": "L3",
    "approver": "owner",
    "gate_on": []
  },
  "default_tier": "L1",
  "tier_caps": {
    "sandbox": "L1",
    "staging": "L1",
    "production": "L1"
  },
  "budget": {
    "caps": {
      "max_usd": 2,
      "max_turns": 40
    },
    "period": "week"
  },
  "wip_limit": 1,
  "dedupe": {
    "against": ["recent_runs"],
    "window_hours": 20
  },
  "metrics": ["ad_spend_usd", "ad_clicks", "subscriptions_from_ads", "usd_per_subscription"],
  "injection_isolation": "The campaign report is untrusted input: campaign and keyword names are text anyone can type. The flow only reads it. It holds no ad account credential and cannot change the campaign, its budget or its bids; any change is the Owner's, made in Google Ads by hand.",
  "created_at": "2026-11-10T00:00:00Z"
}
