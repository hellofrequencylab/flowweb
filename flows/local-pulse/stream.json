{
  "id": "stm_localpulse1",
  "key": "local-pulse",
  "name": "Local pulse",
  "project_id": "prj_frequency1",
  "version": 1,
  "template": "digest",
  "enabled": false,
  "trigger": {"type": "cron", "cron": "0 8 * * 4", "timezone": "America/Los_Angeles", "catch_up": "skip"},
  "inputs": [
    {"name": "upcoming_events", "kind": "query", "ref": "flow://local-pulse/upcoming", "untrusted": true},
    {"name": "groups_and_venues", "kind": "query", "ref": "flow://local-pulse/config", "untrusted": false}
  ],
  "tools": [],
  "action_classes": ["publish_external", "outbound_email_external"],
  "output": {"artifacts": ["marketing_draft_batch"], "result_schema": "run-result.json"},
  "verifier": {"agent_profile": "marketing-reviewer", "vendor_policy": "different_vendor_preferred", "read_only": true},
  "human_gate": {"min_tier": "L3", "approver": "owner", "gate_on": ["publish_external", "outbound_email_external"]},
  "default_tier": "L1",
  "tier_caps": {"sandbox": "L1", "staging": "L1", "production": "L1"},
  "budget": {"caps": {"max_usd": 1, "max_turns": 20}, "period": "week"},
  "wip_limit": 1,
  "dedupe": {"against": ["recent_runs"], "window_hours": 20},
  "metrics": ["events_next_14d"],
  "injection_isolation": "Event titles and towns come from Frequency's upcoming-events read and are untrusted text: fwd fills fixed templates with them and never hands them to a model. Runs draft only (L1): the email roundup, the Instagram caption, the group posts and the host heads-ups all wait for the Owner, who sends or posts each one by hand.",
  "created_at": "2026-11-11T00:00:00Z"
}
