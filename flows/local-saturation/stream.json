{
  "id": "stm_localsat1",
  "key": "local-saturation",
  "name": "Local saturation marketing",
  "project_id": "prj_frequency1",
  "version": 1,
  "template": "custom",
  "enabled": false,
  "trigger": {
    "type": "cron",
    "cron": "0 7 * * 1-5",
    "timezone": "America/Los_Angeles",
    "catch_up": "skip"
  },
  "inputs": [
    {
      "name": "areas_and_signals",
      "kind": "query",
      "ref": "flow://local-saturation/state",
      "untrusted": false
    },
    {
      "name": "local_web_research",
      "kind": "scanner",
      "ref": "flow://local-saturation/research",
      "untrusted": true
    }
  ],
  "tools": [
    {
      "server": "web",
      "tool": "search"
    }
  ],
  "action_classes": ["read_research", "publish_external", "outbound_email_external"],
  "output": {
    "artifacts": ["marketing_draft_batch"],
    "result_schema": "run-result.json"
  },
  "verifier": {
    "agent_profile": "marketing-reviewer",
    "vendor_policy": "different_vendor_preferred",
    "read_only": true
  },
  "human_gate": {
    "min_tier": "L3",
    "approver": "owner",
    "gate_on": ["publish_external", "outbound_email_external"]
  },
  "default_tier": "L1",
  "tier_caps": {
    "sandbox": "L1",
    "staging": "L1",
    "production": "L1"
  },
  "budget": {
    "caps": {
      "max_usd": 5,
      "max_turns": 200
    },
    "period": "week"
  },
  "wip_limit": 1,
  "dedupe": {
    "against": ["recent_runs"],
    "window_hours": 20
  },
  "metrics": ["area_saturation", "members_new_per_area", "drafts_approved_rate", "usd_per_new_member"],
  "injection_isolation": "Everything found on the web about an area is untrusted input. Runs draft text only (L1): they hold no posting, email or account credentials, and every outward item waits for the Owner, who posts it by hand. Core policy denies publish_external and outbound_email_external outright.",
  "created_at": "2026-11-09T00:00:00Z"
}
