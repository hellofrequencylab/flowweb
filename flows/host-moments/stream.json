{
  "id": "stm_hostmoments1",
  "key": "host-moments",
  "name": "Host moments",
  "project_id": "prj_frequency1",
  "version": 1,
  "template": "email",
  "enabled": false,
  "trigger": {"type": "event", "event_type": "frequency.host_event"},
  "inputs": [
    {"name": "frequency_events", "kind": "webhook_payload", "ref": "flow://host-moments/events", "untrusted": true},
    {"name": "facts_sheet", "kind": "query", "ref": "fw-home://facts.json", "untrusted": false}
  ],
  "tools": [],
  "action_classes": ["outbound_email_external"],
  "output": {"artifacts": ["marketing_draft_batch"], "result_schema": "run-result.json"},
  "verifier": {"agent_profile": "marketing-reviewer", "vendor_policy": "different_vendor_preferred", "read_only": true},
  "human_gate": {"min_tier": "L3", "approver": "owner", "gate_on": ["outbound_email_external"]},
  "default_tier": "L1",
  "tier_caps": {"sandbox": "L1", "staging": "L1", "production": "L1"},
  "budget": {"caps": {"max_usd": 1, "max_turns": 10}, "period": "week"},
  "wip_limit": 1,
  "dedupe": {"against": ["recent_runs"], "window_hours": 1},
  "metrics": ["host_notes_drafted", "stalled_hosts_published", "first_event_rsvps_3plus", "founding_purchased"],
  "injection_isolation": "Frequency events are untrusted input: step names, titles and first names are text a host typed. fwd fills fixed templates from them (cleaned, capped, links and control characters removed); no model reads them and nothing is sent. Every note waits in the drafts inbox for the Owner, who sends it himself.",
  "created_at": "2026-11-11T00:00:00Z"
}
