{
  "name": "@fw/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FlowWeb Core local web UI: static bundle served by fwd",
  "scripts": {
    "dev": "vite",
    "mock": "node mock/mock-fwd.mjs",
    "dev:mock": "node mock/dev.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "@fw/contracts": "workspace:*",
    "lucide-react": "0.460.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
