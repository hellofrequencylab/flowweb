{
  "key": "neighborhood-activation",
  "name": "Neighborhood activation",
  "enabled": false,
  "tier": "T2",
  "gate_on": ["publish_external", "outbound_email_external"],
  "offer": {
    "name": "Frequency",
    "url": "https://frequencylocal.com",
    "pitch": "Small local gatherings, hosted by neighbors.",
    "call_to_action": "Host your first gathering"
  },
  "engine": {
    "label": "ChatGPT sign-in through the Codex CLI on the Owner's Mac",
    "fallback": "OpenAI API key, billed per token",
    "runs_on": "local fwd only; the hosted mirror stores no subscription sign-in"
  },
  "sources": [
    {
      "key": "event_listings",
      "label": "Event listings",
      "finds": "people already hosting gatherings",
      "reach": "public pages",
      "action_class": "read_research"
    },
    {
      "key": "business_listings",
      "label": "Business listings",
      "finds": "studios, cafes and halls with space",
      "reach": "public pages",
      "action_class": "read_research"
    },
    {
      "key": "creator_profiles",
      "label": "Creator profiles",
      "finds": "teachers and organizers with a following",
      "reach": "public profiles",
      "action_class": "read_research"
    },
    {
      "key": "local_groups",
      "label": "Local groups",
      "finds": "neighborhood boards and groups",
      "reach": "public posts you make",
      "action_class": "publish_external"
    },
    {
      "key": "frequency_members",
      "label": "Frequency members",
      "finds": "members ready to host",
      "reach": "Frequency messaging",
      "action_class": "outbound_email_external"
    },
    {
      "key": "host_referrals",
      "label": "Host referrals",
      "finds": "people current hosts recommend",
      "reach": "your own email",
      "action_class": "outbound_email_external"
    }
  ],
  "funnels": {
    "host": { "path": "/start/host", "persona": "practitioner", "placeholder": true },
    "venue": { "path": "/start/partner", "persona": "partner" },
    "builder": { "path": "/start/welcome", "persona": "builder" },
    "resident": { "path": "/start/event", "persona": "visitor" }
  },
  "send_routes": {
    "founder_email": {
      "label": "Your own email, as the founder",
      "one_to_one": true,
      "needs": ["honest subject", "who you are", "one-line opt-out: reply no and I won't write again"]
    },
    "frequency": { "label": "Frequency messaging", "adds": ["unsubscribe link", "postal address"] }
  },
  "placeholders": ["host_funnel", "inland_north"],
  "thresholds": {
    "hosts_floor": 100,
    "hosts_per_10k": 0.75,
    "events_per_host_14d": 1,
    "sub_area_share": 0.8,
