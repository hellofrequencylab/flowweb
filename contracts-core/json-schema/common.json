{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/fw/v1/common.json",
  "title": "Common definitions",
  "description": "Shared $defs referenced by every contract. Not a contract itself.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,4}_[0-9A-Za-z]{4,40}$",
      "description": "Prefixed identifier, e.g. wo_01J9ZK3Q7M."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC RFC 3339."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tier": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ],
      "description": "Autonomy tier L0 observe, L1 draft, L2 act in sandbox, L3 act with approval, L4 act with notification, L5 autonomous."
    },
    "trust_tier": {
      "enum": [
        0,
        1,
        2
      ],
      "description": "0 humans-only, 1 agent-proposed human-reviewed, 2 agent-writable within caps."
    },
    "environment": {
      "enum": [
        "sandbox",
        "staging",
        "production"
      ]
    },
    "role": {
      "enum": [
        "owner",
        "chief_of_staff",
        "program_lead",
        "worker",
        "verifier",
        "auditor",
        "watchdog"
      ]
    },
    "agent_role": {
      "enum": [
        "chief_of_staff",
        "program_lead",
        "worker",
        "verifier",
        "auditor",
        "watchdog"
      ]
    },
    "vendor": {
      "enum": [
        "anthropic",
        "openai",
        "google",
        "local",
        "other"
      ]
    },
    "action_class": {
      "enum": [
        "read_research",
        "code_write_sandbox",
        "merge_main",
        "deploy_production",
        "prod_db_migration",
        "outbound_email_external",
        "outbound_email_known_template",
        "support_reply_new_category",
        "support_reply_sensitive",
        "support_reply_faq",
        "spend_money",
        "security_remediation",
        "security_remediation_patch_bump",
        "scheduling_external",
        "scheduling_own",
        "publish_external",
        "incident_runbook_reversible",
        "incident_data_change",
        "config_secrets_iam_dns_billing",
        "memory_write",
        "skill_promote",
        "instruction_edit",
        "policy_or_gate_change",
        "goal_propose",
        "goal_verification_change"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "size": {
      "enum": [
        "XS",
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "usd": {
      "type": "number",
      "minimum": 0
    },
    "pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Path glob, ** allowed."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Link or opaque reference (URL, path, id). Links, never pasted blobs."
    },
    "budget_caps": {
      "type": "object",
      "properties": {
        "max_usd": {
          "$ref": "common.json#/$defs/usd"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "max_turns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "Hard caps. At least one must be present; the supervisor enforces all that are present.",
      "minProperties": 1
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "owner",
            "agent",
            "system",
            "adapter"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 3
        },
        "role": {
          "$ref": "common.json#/$defs/role"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "owner_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "owner"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 3
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "RACI Accountable: always exactly one."
    },
    "artifact_pointer": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "pull_request",
            "commit",
            "message_id",
            "file",
            "report",
            "deploy",
            "calendar_hold",
            "ticket_reply",
            "email_draft"
          ]
        },
        "ref": {
          "$ref": "common.json#/$defs/ref"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false,
      "description": "Pointer to a produced artifact. Agent-claimed until the kernel verifies it."
    },
    "risk_class": {
      "enum": [
        "security",
        "privacy",
        "legal",
        "external_comms",
        "financial",
        "operational",
        "none"
      ]
    },
    "urgency": {
      "enum": [
        "now",
        "today",
        "this_week",
        "whenever"
      ]
    },
    "approval_method": {
      "enum": [
        "deck_click",
        "deck_challenge_phrase",
        "passkey",
        "totp",
        "hardware_key",
        "cli_signed"
      ]
    },
    "rule_of_two": {
      "type": "object",
      "properties": {
        "untrusted_input": {
          "type": "boolean"
        },
        "sensitive_access": {
          "type": "boolean"
        },
        "state_change_or_external_comms": {
          "type": "boolean"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "inputs_hash": {
          "$ref": "common.json#/$defs/sha256"
        }
      },
      "required": [
        "untrusted_input",
        "sensitive_access",
        "state_change_or_external_comms",
        "score"
      ],
      "additionalProperties": false,
      "description": "Computed by the kernel from tool manifest and context provenance; score 3 requires L3 with approval."
    },
    "provenance": {
      "type": "object",
      "properties": {
        "untrusted_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "ref": {
                "$ref": "common.json#/$defs/ref"
              },
              "ingested_at": {
                "$ref": "common.json#/$defs/timestamp"
              }
            },
            "required": [
              "source",
              "ref"
            ],
            "additionalProperties": false
          }
        },
        "rule_of_two": {
          "$ref": "common.json#/$defs/rule_of_two"
        }
      },
      "required": [
        "untrusted_inputs",
        "rule_of_two"
      ],
      "additionalProperties": false
    },
    "probe_expected": {
      "type": "object",
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "stdout_regex": {
          "type": "string"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "json_assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string",
                "description": "RFC 6901 pointer"
              },
              "op": {
                "enum": [
                  "eq",
                  "neq",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "in",
                  "matches",
                  "exists"
                ]
              },
              "value": {}
            },
            "required": [
              "pointer",
              "op"
            ],
            "additionalProperties": false
          }
        },
        "threshold": {
          "type": "object",
          "properties": {
            "metric": {
              "type": "string"
            },
            "op": {
              "enum": [
                "gt",
                "gte",
                "lt",
                "lte",
                "eq"
              ]
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "metric",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        "attestation": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "What passing looks like. At least one assertion is required.",
      "minProperties": 1
    },
    "root_cause_class": {
      "enum": [
        "missing_knowledge",
        "wrong_tool_use",
        "ambiguous_instruction",
        "environment_flake",
        "model_limit",
        "bad_test",
        "infrastructure_error",
        "bad_work_order",
        "policy_or_gate_too_tight",
        "gate_gap",
        "unknown"
      ],
      "description": "Root cause classes shared by retro findings, diagnosis reports and postmortems. bad_work_order, policy_or_gate_too_tight and gate_gap never lead to an instruction edit or a lesson: the first becomes a backlog row, the other two become an Owner note (Tier 0)."
    },
    "injection_suspected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "fragment": {
            "type": "string",
            "maxLength": 200,
            "description": "Quoted fragment, at most 200 characters."
          },
          "location": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "source",
          "fragment",
          "location"
        ],
        "additionalProperties": false
      },
      "description": "Text in DATA that tried to instruct the agent. Recorded, never obeyed (PRE-v1 P3)."
    },
    "stop_condition": {
      "enum": [
        "scope_conflict",
        "premise_false",
        "already_fixed",
        "ambiguous_goal",
        "budget_80",
        "ttl",
        "tool_denied",
        "rule_of_two",
        "injection_suspected",
        "secret_exposed",
        "gate_touch_required",
        "conflict_unresolved",
        "dependency_blocked",
        "unsafe_to_continue",
        "insufficient_evidence",
        "provenance_untrusted",
        "wrong_route",
        "no_retrieval_hit",
        "other"
      ],
      "description": "Reason codes for run.raise_stop and run-result stop_requests[].condition. Free-text conditions are still accepted by run-result; this enum is the closed set agents are prompted to use."
    },
    "tool_call_id": {
      "type": "string",
      "pattern": "^tcl_[0-9A-Za-z]{4,40}$"
    },
    "goal_target": {
      "description": "What the Goal is for. A metric Goal names the number that must move; a checklist Goal is simply its Milestones. Either way progress comes only from verified Milestones, never from this object.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "metric"
            },
            "metric": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 80
                },
                "source": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 120,
                  "description": "Where the number is read from (a metric source the probe runner can query)."
                },
                "comparator": {
                  "enum": [
                    "gte",
                    "lte",
                    "gt",
                    "lt",
                    "eq"
                  ]
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "maxLength": 24
                },
                "baseline": {
                  "type": "number",
                  "description": "Value when the Goal was written; context only."
                }
              },
              "required": [
                "name",
                "source",
                "comparator",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "metric"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "checklist"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "milestone_verification": {
      "description": "How a Milestone is proven. Either a probe (a kernel-executed check, Tier 0, same object as a ledger probe) or an event condition over kernel-written events. There is no third way: an agent saying a Milestone is done never counts.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "probe"
            },
            "probe": {
              "$ref": "probe.json"
            }
          },
          "required": [
            "kind",
            "probe"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "event_condition"
            },
            "event_condition": {
              "type": "object",
              "properties": {
                "event_type": {
                  "enum": [
                    "ledger.row_status_changed",
                    "ledger.probe_executed",
                    "merge_slot.landed",
                    "watch.window_closed_clean",
                    "run.artifact_verified"
                  ],
                  "description": "Only events the kernel writes after its own verification can prove a Milestone."
                },
                "match": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "pointer": {
                        "type": "string",
                        "description": "RFC 6901 pointer into the event payload"
                      },
                      "op": {
                        "enum": [
                          "eq",
                          "neq",
                          "gt",
                          "gte",
                          "lt",
                          "lte",
                          "in",
                          "exists"
                        ]
                      },
                      "value": {}
                    },
                    "required": [
                      "pointer",
                      "op"
                    ],
                    "additionalProperties": false
                  }
                },
                "min_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "default": 1,
                  "description": "How many matching events in the Goal's Project are needed."
                }
              },
              "required": [
                "event_type",
                "match"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "event_condition"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
