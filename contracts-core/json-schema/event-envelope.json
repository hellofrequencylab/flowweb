{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/fw/v1/event-envelope.json",
  "title": "Event envelope",
  "description": "Every row of the append-only, hash-chained Event Log.",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9A-Za-z]{4,40}$"
    },
    "ts": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "type": {
      "enum": [
        "system.started",
        "system.stopped",
        "system.kill_switch_engaged",
        "system.kill_switch_released",
        "system.kill_switch_drill_completed",
        "system.config_changed",
        "system.health_degraded",
        "system.backup_completed",
        "audit.anchor_published",
        "audit.chain_verification_failed",
        "project.created",
        "project.updated",
        "project.paused",
        "stream.created",
        "stream.updated",
        "stream.fired",
        "stream.paused",
        "stream.resumed",
        "stream.degraded",
        "stream.archived",
        "reconciler.completed",
        "reconciler.drift_detected",
        "ledger.row_created",
        "ledger.row_status_changed",
        "ledger.row_premise_retested",
        "ledger.probe_revised",
        "ledger.probe_executed",
        "ledger.row_regressed",
        "goal.created",
        "goal.updated",
        "goal.activated",
        "goal.paused",
        "goal.resumed",
        "goal.completed",
        "goal.abandoned",
        "goal.reopened",
        "goal.milestone_added",
        "goal.milestone_verified",
        "goal.milestone_regressed",
        "goal.milestone_dropped",
        "goal.verification_change_proposed",
        "goal.verification_revised",
        "work_order.drafted",
        "work_order.issued",
        "work_order.superseded",
        "work_order.expired",
        "work_order.cancelled",
        "work_order.completed",
        "work_order.failed",
        "dispatch.refused_budget",
        "dispatch.refused_policy",
        "dispatch.refused_rule_of_two",
        "dispatch.deduped",
        "run.queued",
        "run.started",
        "run.step_recorded",
        "run.paused",
        "run.resumed",
        "run.result_submitted",
        "run.artifact_verified",
        "run.succeeded",
        "run.failed",
        "run.timed_out",
        "run.cancelled",
        "run.killed",
        "run.stop_raised",
        "run.claim_mismatch",
        "tool.call_decided",
        "tool.call_completed",
        "tool.definition_changed",
        "lease.acquired",
        "lease.renewed",
        "lease.released",
        "lease.expired",
        "lease.conflict_queued",
        "grant.requested",
        "grant.issued",
        "grant.consumed",
        "grant.expired",
        "grant.revoked",
        "merge_slot.requested",
        "merge_slot.granted",
        "merge_slot.void",
        "merge_slot.landed",
        "merge_slot.conflict_recheck",
        "approval.requested",
        "approval.responded",
        "approval.consumed",
        "approval.expired",
        "approval.revoked",
        "approval.rejected_hash_mismatch",
        "approval.challenge_failed",
        "approval.rate_limited",
        "approval.sample_audited",
        "approval.denial_vindicated",
        "evidence.bundle_created",
        "evidence.scan_red_blocked",
        "decision_card.created",
        "decision_card.answered",
        "decision_card.expired",
        "decision_card.withdrawn",
        "escalation.raised",
        "escalation.answered",
        "escalation.defaulted",
        "budget.set",
        "budget.threshold_crossed",
        "budget.hard_stop",
        "spend.recorded",
        "breaker.tripped",
        "breaker.reset",
        "agent.registered",
        "agent.suspended",
        "agent.quarantined",
        "agent.reinstated",
        "agent.retired",
        "tier.promotion_proposed",
        "tier.promoted",
        "tier.demoted",
        "policy.rule_changed",
        "policy.tamper_tripwire_fired",
        "policy.diff_policy_failed",
        "policy.rule_of_two_violation",
        "watch.started",
        "watch.window_closed_clean",
        "watch.regression_detected",
        "retro.completed",
        "retro.finding_created",
        "retro.finding_rated",
        "lesson.created",
        "lesson.status_changed",
        "skill.drafted",
        "skill.verified",
        "skill.rejected",
        "skill.promoted",
        "skill.stale",
        "skill.retired",
        "skill.revoked",
        "proposal.opened",
        "proposal.static_check_completed",
        "proposal.review_requested",
        "proposal.status_changed",
        "proposal.rolled_back",
        "learning.freeze_engaged",
        "learning.freeze_released",
        "eval.run_started",
        "eval.run_completed",
        "memory.entry_written",
        "memory.entry_rejected",
        "memory.entry_quarantined",
        "memory.entry_expired",
        "notification.queued",
        "notification.delivered",
        "notification.acked",
        "status_report.published",
        "brief.published",
        "period.closed",
        "ledger.row_proposed",
        "run.stop_resolved",
        "handoff.note_recorded",
        "verification.report_submitted",
        "audit.finding_raised",
        "audit.finding_status_changed",
        "watchdog.alert_raised",
        "draft.created",
        "draft.reviewed",
        "digest.published",
        "digest.rejected",
        "incident.opened",
        "incident.timeline_updated",
        "incident.status_changed",
        "incident.closed",
        "retro.diagnosis_published",
        "retro.report_published",
        "postmortem.drafted",
        "postmortem.accepted",
        "skill.verification_inconclusive"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "$ref": "common.json#/$defs/actor"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[0-9A-Za-z]{4,40}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^stm_[0-9A-Za-z]{4,40}$"
    },
    "work_order_id": {
      "type": "string",
      "pattern": "^wo_[0-9A-Za-z]{4,40}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9A-Za-z]{4,40}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 6
    },
    "causation_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-Za-z]{4,40}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "payload": {
      "type": "object",
      "description": "Free-form JSON object (vendor- or stream-specific).",
      "additionalProperties": true
    },
    "payload_hash": {
      "$ref": "common.json#/$defs/sha256"
    },
    "prev_hash": {
      "$ref": "common.json#/$defs/sha256"
    },
    "hash": {
      "$ref": "common.json#/$defs/sha256"
    }
  },
  "required": [
    "seq",
    "id",
    "ts",
    "type",
    "version",
    "actor",
    "correlation_id",
    "idempotency_key",
    "payload",
    "payload_hash",
    "prev_hash",
    "hash"
  ],
  "additionalProperties": false
}
