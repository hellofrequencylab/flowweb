{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --filter @fw/web...",
  "buildCommand": "VITE_FW_HOSTED=1 pnpm --filter @fw/web build",
  "outputDirectory": "packages/web/dist",
  "rewrites": [
    { "source": "/v1/plugin/:path*", "destination": "/api/plugin?__p=:path*" },
    { "source": "/v1/:path*", "destination": "/api/v1?__p=:path*" },
    { "source": "/((?!api/|v1/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
